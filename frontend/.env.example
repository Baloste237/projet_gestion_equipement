# Adresse de l'API (passerelle Gateway)
# En local :
VITE_API_URL=http://localhost:4000
# En production (ex: déploiement Vercel pointant vers Render) :
# VITE_API_URL=https://mon-backend-render.onrender.com

# Adresse publique de l'application, encodée dans les QR codes des équipements.
# Laisser vide pour utiliser l'origine de la page courante (recommandé).
# En production (URL Vercel) :
# VITE_PUBLIC_APP_URL=https://mon-frontend.vercel.app
VITE_PUBLIC_APP_URL=
