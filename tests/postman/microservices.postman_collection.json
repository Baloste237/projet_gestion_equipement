        {
          "name": "Login Admin User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.success && jsonData.data) {",
                  "    pm.collectionVariables.set(\"jwt_token\", jsonData.data.accessToken);",
                  "    pm.collectionVariables.set(\"refresh_token\", jsonData.data.refreshToken);",
                  "    pm.collectionVariables.set(\"auth_user_id\", jsonData.data.user.id);",
                  "    pm.test(\"Token sauvegardé avec succès\", function () {",
                  "        pm.expect(jsonData.data.accessToken).to.be.a('string');",
                  "    });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
