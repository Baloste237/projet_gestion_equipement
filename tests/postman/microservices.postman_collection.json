      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.collectionVariables.get(\"test_email\")) {",
          "    var randomInt = Math.floor(Math.random() * 1000000);",
          "    pm.collectionVariables.set(\"test_email\", \"admin-\" + randomInt + \"@example.com\");",
          "    pm.collectionVariables.set(\"dept_name\", \"Informatique Q3 - \" + randomInt);",
          "    pm.collectionVariables.set(\"category_name\", \"Laptops Intel - \" + randomInt);",
          "    pm.collectionVariables.set(\"supplier_name\", \"Lenovo France - \" + randomInt);",
          "    pm.collectionVariables.set(\"equipment_sn\", \"SN-LENOVO-\" + randomInt);",
          "    pm.collectionVariables.set(\"inventory_title\", \"Audit Inventaire Q3 - \" + randomInt);",
          "}"
        ]
      }
    }
  ],
