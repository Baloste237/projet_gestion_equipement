        {
          "name": "Add Item to Inventory",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.success && jsonData.data) {",
                  "    if (jsonData.data.id) {",
                  "        pm.collectionVariables.set(\"item_id\", jsonData.data.id);",
                  "    } else if (jsonData.data.items && jsonData.data.items.length > 0) {",
                  "        pm.collectionVariables.set(\"item_id\", jsonData.data.items[jsonData.data.items.length - 1].id);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
