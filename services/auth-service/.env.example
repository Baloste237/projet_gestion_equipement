PORT=4001
DATABASE_URL="postgresql://user:password@localhost:5432/auth_db?schema=public"
JWT_SECRET=your_jwt_secret_here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
RABBITMQ_URL=amqp://guest:guest@localhost:5672
SERVICE_NAME=auth-service

# Secret partagé entre services (envoi d'audit vers audit-service)
INTERNAL_SERVICE_TOKEN=change_me_shared_internal_secret

# Amorçage du premier administrateur (npm run seed:admin) ; à ne pas conserver dans l'environnement après usage
# ADMIN_EMAIL=admin@exemple.fr
# ADMIN_PASSWORD=un-mot-de-passe-long-et-unique
