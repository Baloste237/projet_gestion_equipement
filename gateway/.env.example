PORT=4000
JWT_SECRET=your_jwt_secret_here

AUTH_SERVICE_URL=http://localhost:4001
USER_SERVICE_URL=http://localhost:4002
EQUIPMENT_SERVICE_URL=http://localhost:4003
ASSIGNMENT_SERVICE_URL=http://localhost:4004
INVENTORY_SERVICE_URL=http://localhost:4005
AUDIT_SERVICE_URL=http://localhost:4006

CORS_ORIGIN=http://localhost:3000

# Proxys de confiance devant le gateway : 0 en local, 1 derrière le proxy d'un hébergeur (limiteur de débit par IP réelle)
TRUST_PROXY_HOPS=0

# Fiche publique (QR code) : requêtes autorisées par IP et par fenêtre de 5 minutes (120 par défaut)
PUBLIC_RATE_LIMIT_MAX=120
